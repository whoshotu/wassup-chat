{
  "manifest_version": 3,
  "name": "Wassup - Decode What Your Viewers Are Really Saying",
  "short_name": "Wassup",
  "version": "1.2.0",
  "description": "A chat decoder that helps performers understand what viewers are really saying in slang and foreign languages",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Wassup Decoder",
    "default_icon": {
      "16": "icons/icon-16x16.png",
      "32": "icons/icon-32x32.png",
      "48": "icons/icon-48x48.png",
      "128": "icons/icon-128x128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "128": "icons/icon-128x128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com https://translate.googleapis.com"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "screenshots/*"],
      "matches": ["<all_urls>"]
    }
  ]
}